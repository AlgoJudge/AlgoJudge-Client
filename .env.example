# Copy to .env and adjust. Every VITE_-prefixed value is embedded in the built
# bundle and is therefore public - none of these may hold a secret.

# Base URL of AlgoJudge-Server. Leave empty to run against the fake API.
# 7004 is where the Server's own launch profile puts it.
VITE_APP_API_BASE_URL=https://localhost:7004

# Set to true to force the fake API even when a base URL is configured.
VITE_APP_USE_FAKE_API=false

# Development only, and off by default. A production build ignores it entirely,
# so a deployment cannot be configured into having no authentication.
VITE_APP_DEBUG_AUTHENTICATION=false

# Serve `npm run dev` over HTTPS with the ASP.NET development certificate,
# exporting one through `dotnet dev-certs` if there is none yet. Anything other
# than empty or `false` turns it on. It needs the .NET SDK, so it is off here;
# plain HTTP is what most work needs.
VITE_DOTNET_CERT=false
