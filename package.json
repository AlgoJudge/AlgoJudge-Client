{
  "name": "algojudge-client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "lint:deps": "node scripts/lint-deps.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:package": "node scripts/check-package.mjs",
    "check:languages": "node scripts/check-languages.mjs",
    "check:exchange": "node scripts/check-exchange.mjs",
    "check:zawodyweb": "node scripts/check-zawodyweb.mjs",
    "check:access": "node scripts/check-access.mjs",
    "check:time": "node scripts/check-time.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:events": "node scripts/check-events.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ranking": "node scripts/check-ranking.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:instructions": "node scripts/check-instructions.mjs",
    "check:ui": "node scripts/verify/run.mjs",
    "check:browsers": "node scripts/verify/check-browsers.mjs",
    "check:e2e": "playwright test",
    "check:mobile": "playwright test -c playwright.mobile.config.mjs",
    "check:pwa": "playwright test -c playwright.pwa.config.mjs",
    "browsers": "node scripts/verify/browsers.mjs"
  },
  "dependencies": {
    "@algojudge/uva-explorer-react": "^0.2.0",
    "@mantine/code-highlight": "^9.7.2",
    "@mantine/colors-generator": "^9.7.2",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@monaco-editor/react": "^4.7.0",
    "@shikijs/langs": "^4.5.0",
    "@tabler/icons-react": "^3.49.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.23",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "i18next": "^26.4.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.3",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.18",
    "react-router-dom": "^7.18.3",
    "shiki": "^4.5.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "dompurify": "^3.4.14",
    "flatted": "^3.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
