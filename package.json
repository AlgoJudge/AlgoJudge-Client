{
  "name": "algojudge-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "lint:deps": "node scripts/lint-deps.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
